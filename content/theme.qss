
QWidget { font-family: "Malgun Gothic"; font-size: 9.75pt; color: #393345; }
QDialog, QWidget#chat { background: #faf7fc; }
QLineEdit, QPlainTextEdit, QComboBox { background: white; border: 1px solid #ddd3e5;
 border-radius: 7px; padding: 8px; }
QPushButton { background: #eee5f5; border: none; border-radius: 7px; padding: 9px 14px; }
QPushButton:hover { background: #e2d4ef; }
QPushButton:disabled { color: #999; }
QPushButton#send { background: #8060a3; color: white; }
QScrollArea { border: none; background: transparent; }
QLabel#userMessage { background: #e8dbf5; border-radius: 12px; padding: 12px; }
QLabel#assistantMessage { background: #ffffff; border-radius: 12px; padding: 12px; }
